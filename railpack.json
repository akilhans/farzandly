{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "cd server && npm install"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "cd server && npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd server && npm start"
  }
}
