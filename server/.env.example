# ---------------------------------------------------------------------------
# Farzandly API — copy to .env and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/farzandly

# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:3000
# Set to true only if you want Vercel preview deployments to call this API
ALLOW_VERCEL_PREVIEWS=false
# Public base URL of this API (used when registering the Telegram webhook)
PUBLIC_API_URL=

# Session signing key — REQUIRED in production, at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
BOT_MODE=polling
# Optional: explicit webhook secret (otherwise derived from the bot token)
TELEGRAM_WEBHOOK_SECRET=

# Telegram OIDC login (from @BotFather → Bot Settings → Web Login)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:3000/kirish/callback

# Admins: your Telegram user ID(s), comma-separated. They get /admin access
# and payment notifications (the first ID is also used for notifications if
# ADMIN_TELEGRAM_CHAT_ID is not set).
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_CHAT_ID=

# Lifetime Premium price in so'm
PREMIUM_PRICE_UZS=79000
