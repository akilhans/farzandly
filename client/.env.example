# Farzandly web client — copy to .env.local (or set in Vercel). Never commit real values.

# Express API base URL (browser + server rendering)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Server-only override for server-side calls (optional)
API_URL=
# Public site URL (canonical links, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (lifetime Premium by card transfer)
NEXT_PUBLIC_PAYMENT_CARD=5614 6819 0401 4390
NEXT_PUBLIC_PAYMENT_CARD_HOLDER=
NEXT_PUBLIC_PREMIUM_PRICE=79000
# Telegram username for payment questions (without @)
NEXT_PUBLIC_SUPPORT_TELEGRAM=dadakhonov

# Telegram OAuth client id (public)
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=

# Bot token — only needed for the avatar proxy route (server-side, never NEXT_PUBLIC)
TELEGRAM_BOT_TOKEN=
